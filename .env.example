# Copy to .env (git-ignored) and fill in. Values here are local-dev defaults.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
MLFLOW_TRACKING_URI=http://localhost:5000
KAFKA_BOOTSTRAP=localhost:19092
PROMETHEUS_URL=http://localhost:9090
# Module 5 (SOC copilot): free key from https://aistudio.google.com/apikey (optional; without
# it the copilot uses Ollama). LLM_PROVIDERS=ollama keeps every prompt on this machine.
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
# LLM_PROVIDERS=ollama
# Module 6: set to require a password (any user name) on the API and dashboard.
# Required before serving beyond localhost (sentinel serve --host 0.0.0.0).
SENTINEL_API_KEY=
LOG_LEVEL=INFO
# Host ports (docker compose and `sentinel serve`). To run beside another project that holds
# 8000 and 5432, e.g. SENTINEL_PORT=8010 and POSTGRES_PORT=5433, and point POSTGRES_URL /
# POSTGRES_RO_URL at localhost:5433. Changing MLFLOW_PORT or PROMETHEUS_PORT also means
# changing MLFLOW_TRACKING_URI / PROMETHEUS_URL; a host API on another port also needs
# its port in monitoring/prometheus.yml.
SENTINEL_PORT=8000
POSTGRES_PORT=5432
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
